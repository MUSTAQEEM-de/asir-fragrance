# --- Backend (server/) ---

# MongoDB connection string.
# Local dev (via `docker compose up -d`): mongodb://localhost:27017/asir-fragrance
# Production: your MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017/asir-fragrance

# Secret used to sign JWT auth tokens. Generate a long random value for production,
# e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

PORT=5000
NODE_ENV=development

# Must exactly match the deployed frontend origin (used for CORS + cookie settings).
CLIENT_URL=http://localhost:3000

# --- Frontend (Vite) ---
# Base URL of the deployed backend API, read via import.meta.env.VITE_API_URL.
VITE_API_URL=http://localhost:5000/api
